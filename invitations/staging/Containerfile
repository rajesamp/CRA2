FROM ghcr.io/astral-sh/uv:0.12.16@sha256:6ac5600728c2219355bfd63b3d5e127e42d5ed27b7448b950d8a3573189fa250 AS uv
FROM docker.io/library/python:3.13-slim-trixie@sha256:e123d49d13f666b842ae2b925bf30703910481c67c89edc0a6b42e09d2b2168d AS python

FROM python AS build
COPY --from=uv /uv /usr/local/bin/uv
WORKDIR /app
ENV UV_LINK_MODE=copy UV_PYTHON_DOWNLOADS=never UV_NO_BUILD=1
COPY pyproject.toml uv.lock ./
RUN uv sync --locked --no-dev --python /usr/local/bin/python3.13

FROM python
WORKDIR /app
COPY --from=build /app/.venv /app/.venv
COPY __init__.py policy.py ./invitations/
COPY staging/__init__.py staging/app.py staging/google.py staging/sessions.py staging/firestore_sessions.py staging/serve.py ./invitations/staging/
ENV PORT=8080 PYTHONDONTWRITEBYTECODE=1 PYTHONNOUSERSITE=1
USER 65532:65532
EXPOSE 8080
ENTRYPOINT ["/app/.venv/bin/python", "-m", "invitations.staging.serve"]
