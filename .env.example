# Copy to .env and fill in (never commit .env). Loading is explicit:
# CRA2_ENV_FILE=.env uv run cra2 CHG-06 --mode auto
# Existing exported environment values take precedence over this file.

# Groq API key from https://console.groq.com/keys. Not needed for --mode fast.
GROQ_API_KEY=

# Requested Groq model ID; provider-side model revisions can change behavior.
# Validate changes with an eval run (see docs/adr/adr-001-groq.md).
CRA2_MODEL=openai/gpt-oss-20b

# fast: local rules only · auto: Groq when rules are unsure · deep: always try Groq
CRA2_MODE=auto

# Fixed sampling settings reduce variation; live responses are not guaranteed identical.
# Timeout must be finite and positive; max tokens must be a positive integer.
CRA2_SEED=7
CRA2_TIMEOUT_S=10
CRA2_MAX_TOKENS=1024

# Live tests also require an explicit exported CRA2_RUN_LIVE_TESTS=1.
# Leave that flag unset for ordinary offline development.
