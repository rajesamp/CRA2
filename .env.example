# Copy to .env and fill in (never commit .env).

# Groq API key from https://console.groq.com/keys. Not needed for --mode fast.
GROQ_API_KEY=

# Pinned Groq model. Change it only after an eval run (see docs/adr/adr-001-groq.md).
CRA2_MODEL=openai/gpt-oss-20b

# fast: System 1 only (no key, microseconds) · auto: Groq only when System 1 is unsure · deep: always Groq
CRA2_MODE=auto

# Determinism and latency knobs.
CRA2_SEED=7
CRA2_TIMEOUT_S=10
CRA2_MAX_TOKENS=1024
